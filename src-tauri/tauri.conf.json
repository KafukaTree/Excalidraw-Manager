{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excalidraw Manager",
  "version": "0.5.0",
  "identifier": "io.github.kafukatree.excalidraw-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Excalidraw Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Manage local Excalidraw workspaces",
    "longDescription": "A local-first cross-platform manager for Excalidraw boards, libraries, and formula tools.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../runtime/": "runtime/",
      "../node_modules/excalidraw-edit/src/public/": "excalidraw-public/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
